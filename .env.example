# ==============================================================================
# AXON X - ENVIRONMENT VARIABLES (OPTIONAL / DEFAULTS PROVIDED)
# ==============================================================================

# Site URL for SEO / Sitemap (Defaults to http://localhost:3000 or Vercel URL)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Discord Bot OAuth2 Invite Link (Already configured with bot ID in site-config.ts)
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1479842310081482792&permissions=8&scope=bot+applications.commands

# Discord Support Server
NEXT_PUBLIC_SUPPORT_SERVER_URL=https://discord.gg/codexdevs

# Dashboard URL (Defaults to #dashboard)
NEXT_PUBLIC_DASHBOARD_URL=#dashboard

# Documentation URL (Defaults to #documentation)
NEXT_PUBLIC_DOCUMENTATION_URL=#documentation

# GitHub Profile URL
NEXT_PUBLIC_GITHUB_URL=https://github.com/MohsinAli088

# System Status Page URL
NEXT_PUBLIC_STATUS_URL=#status

# Optional Database Connection String (Not required for landing page)
DATABASE_URL=
